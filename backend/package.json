{
  "name": "@yet-another-retro-tool/backend",
  "version": "1.0.0",
  "description": "Backend API for Yet Another Retro Tool",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "heroku-postbuild": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist node_modules",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:verify": "ts-node -r tsconfig-paths/register src/database/verify.ts",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:fix-positions": "ts-node -r tsconfig-paths/register src/database/migrations/fix-card-positions.ts"
  },
  "dependencies": {
    "@yet-another-retro-tool/shared": "file:../shared",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.2"
  },
  "keywords": [
    "express",
    "typescript",
    "api",
    "retrospective"
  ],
  "author": "",
  "license": "ISC"
}
