{
  "name": "yet-another-retro-tool",
  "version": "1.0.0",
  "description": "A full-stack application to host/attend retrospectives in a team",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend:wait\"",
    "dev:all": "npm run db:up && npm run dev",
    "dev:frontend:wait": "echo '⏳ Waiting for backend to be ready...' && wait-on http://localhost:5000/api/health && echo '✅ Backend ready! Starting frontend...' && npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "heroku-postbuild": "echo '🔧 Building shared package...' && npm run build --workspace=shared && echo '🔧 Building backend...' && npm run build --workspace=backend && echo '🔧 Copying migration files...' && cp -r backend/src/database/migrations backend/dist/database/ && echo '✅ Build complete!'",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "install:all": "npm install",
    "db:up": "docker-compose up -d postgres",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:drop": "npm run db:drop --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "kill-port": "npx kill-port",
    "kill-frontend": "npx kill-port 3000",
    "kill-backend": "npx kill-port 5000",
    "kill-all": "npx kill-port 3000 5000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^8.57.0",
    "kill-port": "^2.0.1",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.2.5",
    "wait-on": "^9.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-personal:WarVDine/yet-another-retro-tool.git"
  },
  "keywords": [
    "retrospective",
    "agile",
    "team",
    "collaboration",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
